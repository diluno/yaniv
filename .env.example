# Redis connection (TCP). Locally: docker run -d -p 6379:6379 redis:7-alpine
# On Vercel with Upstash, UPSTASH_REDIS_URL is injected by the integration.
REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_URL=rediss://default:password@host:port

# Public origin used in share links (optional; defaults to request origin)
# PUBLIC_APP_ORIGIN=https://yaniv.example.com
